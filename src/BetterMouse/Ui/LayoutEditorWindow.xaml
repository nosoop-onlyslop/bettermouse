<Window x:Class="BetterMouse.Ui.LayoutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterMouse — Display Layout"
        Icon="pack://application:,,,/Assets/bettermouse.ico"
        Height="640" Width="980"
        Background="#FF1B1B1F" Foreground="#FFEDEDED"
        UseLayoutRounding="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF26262B" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Save" Click="OnSave" Padding="10,4" Margin="0,0,8,0" />
                <Button Content="Reset to defaults" Click="OnReset" Padding="10,4" Margin="0,0,12,0" />
                <TextBlock VerticalAlignment="Center" Foreground="#FFB7B7B7"
                           Text="Drag a handle along its edge. Double-click an edge to add a handle. Right-click a handle to delete it." />
            </StackPanel>
        </Border>

        <Canvas x:Name="Surface" Background="#FF121215" ClipToBounds="True"
                MouseLeftButtonDown="OnSurfaceMouseDown"
                MouseLeftButtonUp="OnSurfaceMouseUp"
                MouseMove="OnSurfaceMouseMove"
                MouseRightButtonDown="OnSurfaceRightMouseDown" />
    </DockPanel>
</Window>
